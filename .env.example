# Only needed for the stdio transport (src/index.ts), e.g. VS Code / local CLI use.
MOLLIE_API_KEY=your_mollie_api_test_or_live_key

# Only used by the HTTP + OAuth transport (src/httpServer.ts). Never set a
# Mollie API key for this mode -- credentials come from each request's
# bearer token instead, obtained by the MCP client via browser login.
# PORT=3001
# MCP_SERVER_URL=http://localhost:3001/mcp
